cursor {
    xcursor-theme "Adwaita"
    xcursor-size 20
}

input {
    keyboard {
        numlock
        xkb {
            options "caps:super"
        }
    }
    // Prevents scrolling when it would only focus a tiny amount of the window
    focus-follows-mouse max-scroll-amount="95%"
}

recent-windows {
    highlight {
        corner-radius 8
    }
}

layout {
    // Allow wallpaper on overview backdrop layer to show through
    background-color "transparent"

    focus-ring {
        active-color "#7daea3"
    }

    tab-indicator {
        width 8
        active-color "#e78a4e"
    }

    // Cycle between 1/3, 1/2, 2/3 of the output, and a fixed 1280 logical pixels.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66666
    }
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

include "binds.kdl"
include "rules.kdl"
