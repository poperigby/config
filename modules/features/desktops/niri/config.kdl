cursor {
    xcursor-theme "Adwaita"
    xcursor-size 20
}

input {
    keyboard {
        xkb {
            options "caps:super"
        }
    }
    focus-follows-mouse
}

recent-windows {
    highlight {
        corner-radius 8
    }
}

hotkey-overlay {
    skip-at-startup
}

include "binds.kdl"
include "rules.kdl"
